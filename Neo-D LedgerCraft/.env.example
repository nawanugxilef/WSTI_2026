# Neo-D LedgerCraft Environment Variables (Copy to .env and fill with your own credentials)

# 1. Google Gemini AI API Key (Get free key from: https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Telegram Bot Configuration (Create bot via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_OWNER_CHAT_ID=your_telegram_chat_id_here

# 3. Google Drive Folder IDs (Optional cloud backup folders)
GDRIVE_ROOT_FOLDER_ID=your_gdrive_root_folder_id_here
GDRIVE_RECEIPTS_FOLDER_ID=your_gdrive_receipts_folder_id_here
GDRIVE_BACKUPS_FOLDER_ID=your_gdrive_backups_folder_id_here
GDRIVE_STATEMENTS_FOLDER_ID=your_gdrive_statements_folder_id_here
