# Neo-D LedgerCraft — Environment Configuration Template
# Strictly [FICTIONAL DEMO] and contest configuration only.
# Never commit real API keys, tokens, or credentials to git.

# -----------------------------------------------------------------------------
# Google Gemini Multimodal AI (Required for receipt OCR & intelligent categorization)
# -----------------------------------------------------------------------------
# Obtain from Google AI Studio (https://aistudio.google.com/).
# NOTE: For competition / public demos, use a contest-only key with an active spending limit.
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Telegram Receipt Companion Bot (@neo_ledgercraft_bot)
# -----------------------------------------------------------------------------
# Obtain from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Mandatory owner Chat ID (numeric).
# The bot runs in strict fail-closed mode: any message from an unconfigured or
# non-matching chat ID is immediately rejected without invoking LLM tokens.
TELEGRAM_OWNER_CHAT_ID=123456789

# -----------------------------------------------------------------------------
# Live Web Dashboard & Local Server Configuration
# -----------------------------------------------------------------------------
# Host to bind the web server to (default: 127.0.0.1 for local/SSH-tunnel/Tailscale use).
# When deploying to containerized hosts (Render/Railway/Docker), set to 0.0.0.0.
WEB_HOST=127.0.0.1

# HTTP port (default: 8080). Supports both WEB_PORT and standard cloud PORT.
WEB_PORT=8080

# Optional Bearer Token for mutation endpoints (POST /api/reward, POST /api/correct).
# When set, mutating requests must include: "Authorization: Bearer <WEB_ADMIN_TOKEN>".
# Leave empty to allow unrestricted local mutation in demo mode.
WEB_ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# Google Drive Backup Adapter (Optional / CLI-based)
# -----------------------------------------------------------------------------
# Fictional / demo folder IDs for receipt archive and automated database snapshots.
GDRIVE_RECEIPTS_FOLDER_ID=
GDRIVE_BACKUPS_FOLDER_ID=
GDRIVE_STATEMENTS_FOLDER_ID=
